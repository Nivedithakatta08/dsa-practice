class Solution:
    def isValid(self, s: str) -> bool:
        b_map = {')':'(', ']':'[', '}':'{'}
        stack = []
        for char in s:
            if char in b_map:
                top_el = stack.pop() if stack else '#'
            
                if b_map[char] != top_el:
                   return False
            else:
                stack.append(char)

        return len(stack)==0

        
